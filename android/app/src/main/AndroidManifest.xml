<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="SceneTrace" android:icon="@drawable/brand" android:theme="@style/AppTheme"
        android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true">
        <activity android:name=".BrowserActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
